{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to SMAPI",
      "type": "coreclr",
      "request": "attach",
      "processName": "StardewModdingAPI"
    },
    {
      "name": "Launch SMAPI",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/stardew_install_symlink/StardewModdingAPI",
      "cwd": "${workspaceFolder}/stardew_install_symlink",
      "targetArchitecture": "x86_64",
      "preLaunchTask": "build"
    }
  ]
}
