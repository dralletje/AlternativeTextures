<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>9.0.0</Version>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <EnableHarmony>true</EnableHarmony>
    <Nullable>enable</Nullable>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup>
	  <EnableModZip>false</EnableModZip>
	  <GamePath>../stardew_install_symlink</GamePath>
	  <EnableModDeploy>true</EnableModDeploy>
	  <GameModsPath>../Mods</GameModsPath>
	</PropertyGroup>

  <PropertyGroup>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <BundleExtraAssemblies>ThirdParty</BundleExtraAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="releases\**" />
    <EmbeddedResource Remove="releases\**" />
    <None Remove="releases\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.1.1" />
    <PackageReference Include="PolySharp" Version="1.16.0" />
    <PackageReference Include="System.Collections.Immutable" Version="10.0.11" />
    <PackageReference Include="System.Runtime.Experimental" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Packages\ConsoleLog\ConsoleLog.csproj" />
    <ProjectReference Include="..\Packages\DralGeometry\DralGeometry.csproj" />
    <ProjectReference Include="..\Packages\Dral.Sprites\Dral.Sprites.csproj" />
    <ProjectReference Include="..\Packages\Prisms\Prisms.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SkiaSharp">
      <HintPath>$(GamePath)\SkiaSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
	  <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
	   <NoWarn>$(NoWarn);CA2252</NoWarn>
    <WarningsAsErrors>CS8509</WarningsAsErrors>
    <WarningsAsErrors>CS8618</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Update="i18n\**.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- <None Update="manifest.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None> -->
  </ItemGroup>

  <Target Name="RepackMod" AfterTargets="Build">
    <ItemGroup>
      <InputAssemblies Include="$(TargetPath)" />
      <InputAssemblies Include="$(TargetDir)System.Collections.Immutable.dll" />
    </ItemGroup>

    <ILRepack
      Parallel="true"
      Internalize="true"
      RenameInternalized="true"
      InputAssemblies="@(InputAssemblies)"
      OutputFile="$(TargetPath)"
      LibraryPath="$(TargetDir);@(ReferencePath->'%(RootDir)%(Directory)'->Distinct())"
    />
  </Target>

  <PropertyGroup>
    <PostBuildEventDependsOn>
			$(PostBuildEventDependsOn);
			PostBuildMacros;
		</PostBuildEventDependsOn>
  </PropertyGroup>
</Project>
